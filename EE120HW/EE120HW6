// Question 1: Translate ASM code to C code

// r0 = n (input/output), r1 = i (counter), r2 = result
int func(int n) {
    int result = 1;                  // MOV r2, #1
    for (int i = 1; i <= n; i++) {   // MOV r1, #1 / CMP r1, r0 / BGT done / ADD r1, r1, #1 / B loop
        result = result * i;         // MUL r2, r1, r2
    }
    return result;                   // MOV r0, r2
}

